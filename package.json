        "@types/istanbul-reports": "^3.0.4",
        "@types/lcov-parse": "^1.0.2",
        "@types/mssql": "^12.3.0",
        "@types/oracledb": "^26.0.0",
        "@types/pg": "^8.23.1",
        "@vitest/coverage-v8": "^5.0.5",
        "@vitest/ui": "^5.0.5",
        "better-sqlite3": "^13.0.3",
        "lcov-parse": "^1.0.0",
        "mariadb": "^3.5.4",
        "monocart-coverage-reports": "^3.0.0",
        "mssql": "^12.7.11",
        "mysql2": "^3.24.6",
        "oracledb": "^26.0.0",
        "pg": "^8.23.1",
