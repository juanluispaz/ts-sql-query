    "scripts": {
        "codegen": "bash scripts/codegen.sh",
        "codegen:doc-code": "bash scripts/codegen-doc-code.sh",
        "all-examples": "sh ./scripts/all-examples.sh",
        "no-docker-examples": "sh ./scripts/no-docker-examples.sh",
        "validate": "tsc --noEmit",
        "validate:tests": "bash scripts/validate-tests.sh",
        "validate:tests:newest": "tsc -p test/tsconfig.newest.json --noEmit",
        "tests": "bash scripts/tests.sh",
        "tests:runners": "bash scripts/tests.sh runners",
        "tests:audit": "bash scripts/tests-audit.sh",
        "tests:index": "bash scripts/tests-index.sh",
        "tests:index:newest": "bash scripts/tests-index.sh --newest",
        "tests:index:verify": "bash scripts/tests-index-verify.sh",
        "tests:where-is": "bash scripts/tests-where-is.sh",
        "tests:where-is:check": "bash scripts/tests-where-is-check.sh",
        "tests:stop-containers": "bash scripts/tests-stop-containers.sh",
        "tests:reopen": "bash scripts/tests-reopen.sh",
        "tests:propagate": "bash scripts/tests-propagate.sh",
        "tests:mark": "bash scripts/tests-mark.sh",
        "tests:sync-transform": "bash scripts/tests-sync-transform.sh",
        "test:fastest": "bash scripts/tests.sh --native none",
        "test:fast": "bash scripts/tests.sh",
        "test:no-docker": "bash scripts/tests.sh --wasm",
        "test:no-docker:shard": "bash scripts/tests.sh --shard",
        "test:complete:fast": "bash scripts/tests.sh --docker",
        "test:complete:fast:newest": "bash scripts/tests.sh --docker newest",
        "test:complete": "bash scripts/tests.sh --docker --wasm",
        "coverage:report": "bash scripts/tests.sh --use-vitest --use-node --coverage --native none --open 'mariadb/*/mariadb' 'mysql/*/mysql2' 'oracle/*/oracledb' 'oracle/newest/oracledb-boolean' 'postgres/*/pg' 'sqlite/*/better-sqlite3' 'sqlserver/*/mssql'",
        "coverage:report:newest": "bash scripts/tests.sh --use-vitest --use-node --coverage --native none --open mariadb/newest/mariadb mysql/newest/mysql2 oracle/newest/oracledb postgres/newest/pg sqlite/newest/better-sqlite3 sqlserver/newest/mssql",
        "coverage:for-discover-tests": "bash scripts/tests.sh --use-vitest --use-node --coverage --coverage-format json --coverage-format json-summary --coverage-format text-summary --native none 'mariadb/*/mariadb' 'mysql/*/mysql2' 'oracle/*/oracledb' 'oracle/newest/oracledb-boolean' 'postgres/*/pg' 'sqlite/*/better-sqlite3' 'sqlserver/*/mssql'",
        "coverage:for-discover-tests:newest": "bash scripts/tests.sh --use-vitest --use-node --coverage --coverage-format json --coverage-format json-summary --coverage-format text-summary --native none mariadb/newest/mariadb mysql/newest/mysql2 oracle/newest/oracledb postgres/newest/pg sqlite/newest/better-sqlite3 sqlserver/newest/mssql",
        "coverage:runners": "bash scripts/tests.sh --use-vitest --use-bun --coverage --coverage-scope runners runners --docker --wasm --open",
        "coverage:runners:for-discover-tests": "bash scripts/tests.sh --use-vitest --use-bun --coverage --coverage-scope runners --coverage-format json --coverage-format json-summary --coverage-format text-summary runners --docker --wasm",
        "coverage:runners:with-matrix": "bash scripts/tests.sh --use-vitest --use-bun --coverage --coverage-scope runners --coverage-format json --coverage-format json-summary --coverage-format text-summary runners '*/newest' --docker --wasm",
        "coverage:mappers": "bash scripts/tests.sh --use-vitest --use-bun --coverage --coverage-scope mappers runners --docker --wasm --open",
        "coverage:mappers:for-discover-tests": "bash scripts/tests.sh --use-vitest --use-bun --coverage --coverage-scope mappers --coverage-format json --coverage-format json-summary --coverage-format text-summary runners --docker --wasm",
        "coverage:mappers:with-matrix": "bash scripts/tests.sh --use-vitest --use-bun --coverage --coverage-scope mappers --coverage-format json --coverage-format json-summary --coverage-format text-summary runners '*/newest' --docker --wasm",
        "coverage:reopen": "bash scripts/tests-reopen.sh",
        "build": "rm -rf dist/*; tsc --version && tsc -p tsconfig.build.json",
        "dist": "npm run build && cp LICENSE.md package.json README.md dist && python3 -B scripts/llms.py --package dist && cd dist && npm stage publish",
        "dist-alpha": "npm run build && cp LICENSE.md package.json README.md dist && python3 -B scripts/llms.py --package dist && cd dist && npm stage publish --tag alpha",
        "dist-beta": "npm run build && cp LICENSE.md package.json README.md dist && python3 -B scripts/llms.py --package dist && cd dist && npm stage publish --tag beta",
        "docs": "mkdocs serve",
        "docs:check": "mkdocs build --strict --site-dir \"$(mktemp -d)\"",
        "docs:sql-tabs": "bash scripts/docs-sql-tabs.sh"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/juanluispaz/ts-sql-query.git"
    },
    "bugs": {
        "url": "https://github.com/juanluispaz/ts-sql-query/issues"
    },
    "homepage": "https://ts-sql-query.readthedocs.io/",
