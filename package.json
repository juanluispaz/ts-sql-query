        "jooq",
        "querydsl",
        "typescript",
        "mariadb",
        "mysql",
        "oracle",
        "sqlite",
        "sqlserver",
        "sql-server",
        "sql server",
        "postgre sql",
        "postgresql",
        "typesql",
        "type-sql",
        "type sql",
        "type-safe sql",
        "type safe sql",
        "typesafe sql",
