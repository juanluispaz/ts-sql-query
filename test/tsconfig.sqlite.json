{
    // Per-database slice of the test matrix for `validate:tests`.
    // Inherits the FULL include from ./tsconfig.json (test files + src +
    // src/examples + shared test infra) and only excludes the sibling
    // databases, so every shared/global file is still type-checked here.
    // Splitting keeps each tsgo program's peak memory well under the
    // whole-matrix ~12 GB that OOM-kills 16 GB CI runners. See
    // scripts/validate-tests.sh.
    "extends": "./tsconfig.json",
    "exclude": ["db/mariadb", "db/mysql", "db/oracle", "db/postgres", "db/sqlserver"]
}
